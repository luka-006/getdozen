NEXT_PUBLIC_SITE_URL=https://getdozen.dev
NEXT_PUBLIC_LAUNCH_STARTED_AT=2026-07-26T00:00:00.000Z
# Waitlist lock. Set false to show waitlist only (admins bypass).
# LAUNCH_OPEN=false
CRON_SECRET=generate-a-long-random-string

# Hidden admin console (direct link only — not in nav)
# ADMIN_CONSOLE_PATH=/ops-your-secret-here
# ADMIN_OWNER_EMAIL=lukakasalo96@gmail.com
# ADMIN_TOTP_SECRET=base32-from-npx-otplib-generateSecret
# ADMIN_SESSION_SECRET=long-random-string

# Soft launch: comma-separated codes required at signup when set
# INVITE_CODES=dozen-early,friend-42

# Stripe (Checkout + webhook)
STRIPE_SECRET_KEY=sk_live_...or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...or_pk_test_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# Resend — all site mail uses hello@getdozen.dev
RESEND_API_KEY=re_...
RESEND_FROM=Dozen <hello@getdozen.dev>
LEGAL_EMAIL=hello@getdozen.dev
SUPPORT_TO=hello@getdozen.dev

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Croatian e-commerce Art. 6 + GDPR (server-only). One line shown on Terms / Legal / Privacy.
LEGAL_EMAIL=hello@getdozen.dev
LEGAL_OPERATOR_NAME=Kasalo Digital
LEGAL_BUSINESS_FORM=paušalni obrt
LEGAL_ADDRESS=Tvrtkova 1, Knin, Croatia
LEGAL_OIB=your-oib
# Leave empty if not VAT registered (paušal):
# LEGAL_VAT_ID=
# LEGAL_REGISTER=

# Cloudflare Turnstile (login, signup, reset, waitlist, support, bug report)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=getdozen.dev,www.getdozen.dev
