NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CREDENTIALS_ENCRYPTION_KEY=generate-a-32-byte-hex-or-base64-secret
NEXT_PUBLIC_SITE_URL=https://getdozen.dev
NEXT_PUBLIC_LAUNCH_STARTED_AT=2026-07-26T00:00:00.000Z
# Waitlist lock. false = waitlist-only (hard 404 on the rest of the product).
# Set this on Production, Preview, and Development if every deployment should lock.
# LAUNCH_OPEN=false
# Comma-separated. Visiting /invite/<code> sets a 30-day httpOnly cookie that
# passes the lock. Codes are matched case-insensitively.
# INVITE_CODES=dozen-early,friend-42
# Signs the invite cookie. Falls back to CREDENTIALS_ENCRYPTION_KEY when unset.
# Rotating this signs everyone out of the unlock. At least 16 characters.
# INVITE_COOKIE_SECRET=
# Comma-separated emails that pass the lock when that person is signed in.
# A normal session does not. ADMIN_OWNER_EMAIL is included automatically.
# ADMIN_EMAILS=lukakasalo96@gmail.com
CRON_SECRET=generate-a-long-random-string

# Hidden admin console (direct link only — not in nav)
# ADMIN_CONSOLE_PATH=/ops-your-secret-here
# ADMIN_OWNER_EMAIL=lukakasalo96@gmail.com
# ADMIN_TOTP_SECRET=base32-from-npx-otplib-generateSecret
# ADMIN_SESSION_SECRET=long-random-string

# Signup form: the same INVITE_CODES list above is required when it is set.

# Stripe (Checkout + webhook)
STRIPE_SECRET_KEY=sk_live_...or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...or_pk_test_...
STRIPE_PRICE_PRO_MONTHLY=price_...
# Dot packs (legacy STRIPE_PRICE_CREDITS_* still works)
STRIPE_PRICE_DOTS_1=price_...
STRIPE_PRICE_DOTS_5=price_...
STRIPE_PRICE_DOTS_15=price_...
STRIPE_PRICE_DOTS_25=price_...

# Resend — public face hello@getdozen.dev, owner inbox below
RESEND_API_KEY=re_...
RESEND_FROM=Dozen <hello@getdozen.dev>
# Where support/bug mail and inbound forwards land (your Gmail)
MAIL_FORWARD_TO=luka.kasalo.web@gmail.com
SUPPORT_TO=luka.kasalo.web@gmail.com
# Resend webhook signing secret (Dashboard → Webhooks → inbound receiver)
RESEND_WEBHOOK_SECRET=whsec_...
LEGAL_EMAIL=hello@getdozen.dev

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Croatian e-commerce Art. 6 + GDPR (server-only). One line shown on Terms / Legal / Privacy.
LEGAL_EMAIL=hello@getdozen.dev
LEGAL_OPERATOR_NAME=Kasalo Digital
LEGAL_BUSINESS_FORM=paušalni obrt
LEGAL_ADDRESS=Tvrtkova 1, Knin, Croatia
LEGAL_OIB=05372595966
# Leave empty if not VAT registered (paušal):
# LEGAL_VAT_ID=
# LEGAL_REGISTER=

# Cloudflare Turnstile (login, signup, reset, waitlist, support, bug report)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=getdozen.dev,www.getdozen.dev

# Preview / QA scripts (capture-waitlist-phones, generate-launch-video, qa-smoke)
PREVIEW_BASE_URL=https://getdozen.dev
PREVIEW_LOGIN_EMAIL=
QA_BASE_URL=http://localhost:3000

