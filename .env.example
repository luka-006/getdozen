NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CREDENTIALS_ENCRYPTION_KEY=generate-a-32-byte-hex-or-base64-secret
NEXT_PUBLIC_SITE_URL=https://getdozen.dev
NEXT_PUBLIC_LAUNCH_STARTED_AT=2026-07-26T00:00:00.000Z
# Waitlist is currently off for product testing. Set false to lock the site.
# LAUNCH_OPEN=false
CRON_SECRET=generate-a-long-random-string

# Comma-separated invite codes; if set, signup requires one of them
# INVITE_CODES=dozen-early,friend-42

# Stripe (Checkout + webhook)
STRIPE_SECRET_KEY=sk_live_...or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...or_pk_test_...

# Optional Dashboard price IDs (Pro only recommended — credit packs use €1/credit price_data)
# STRIPE_PRICE_CREDITS_* ignored for checkout; amounts come from src/lib/pricing.ts
STRIPE_PRICE_PRO_MONTHLY=price_...

# Croatian e-commerce Art. 6 + GDPR controller identity (server-only).
# Fill before taking payments. Do not invent OIB / court register / VAT.
# LEGAL_EMAIL=hello@getdozen.dev
# LEGAL_OPERATOR_NAME=
# LEGAL_ADDRESS=
# LEGAL_OIB=
# LEGAL_VAT_ID=
# LEGAL_REGISTER=

# Cloudflare Turnstile (bot check on login, signup, reset, waitlist).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Dummy always-pass keys (local tests only):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
